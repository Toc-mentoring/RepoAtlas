# Until the development backend is deployed, use mock explicitly.
VITE_API_MODE=mock
# The full API base path, including /api/v1. Same origin is recommended.
VITE_API_BASE_URL=/api/v1
# Vite development proxy only: backend origin, without /api/v1.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional when the backend serves its schema outside the default /openapi.json.
# VITE_API_SCHEMA_URL=/openapi.json
