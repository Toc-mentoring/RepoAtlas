# 서버에서 infra/.env로 복사해 값을 채운다. infra/.env는 커밋하지 않는다(.gitignore).
# DB URL에 그대로 들어가므로 영문·숫자만 사용한다: openssl rand -hex 24
POSTGRES_PASSWORD=
# 권한 없는 fine-grained 토큰이면 충분. 비우면 GitHub API가 시간당 60회로 제한된다.
GITHUB_TOKEN=

# 선택: Worker 분석 제한 (기본값)
# MAX_ARCHIVE_BYTES=536870912
# MAX_EXTRACTED_BYTES=2147483648
# MAX_FILES=100000
# MAX_SOURCE_FILE_BYTES=1048576
# ANALYSIS_TIMEOUT_SECONDS=900

# 선택: 외부에 여는 포트 (Apache 등이 80을 쓰면 8080으로 바꾸고 프록시)
# WEB_PORT=80
